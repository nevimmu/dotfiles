[
  {
    "battery": {
      "format": "{icon}",
      "format-icons": [
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ],
      "rotate": 0,
      "states": {
        "critical": 15,
        "warning": 30
      },
      "tooltip-format": "{capacity}%"
    },
    "bluetooth": {
      "format-connected": "",
      "format-disabled": "󰂲",
      "format-off": "󰂲",
      "format-on": "",
      "on-click": "kitty --class center-float bluetuith"
    },
    "clock#H": {
      "actions": {
        "on-click-backward": "tz_down",
        "on-click-forward": "tz_up",
        "on-click-right": "mode",
        "on-scroll-down": "shift_down",
        "on-scroll-up": "shift_up"
      },
      "calendar": {
        "format": {
          "months": "<span color='#ffead3'><b>{}</b></span>",
          "today": "<span color='#ff6699'><b>{}</b></span>",
          "weekdays": "<span color='#ffcc66'><b>{}</b></span>"
        },
        "mode-mon-col": 3,
        "on-click-right": "mode",
        "on-scroll": 1
      },
      "format": "{:%H}",
      "interval": 1,
      "rotate": 0,
      "tooltip-format": "<tt>{calendar}</tt>"
    },
    "clock#M": {
      "actions": {
        "on-click-backward": "tz_down",
        "on-click-forward": "tz_up",
        "on-click-right": "mode",
        "on-scroll-down": "shift_down",
        "on-scroll-up": "shift_up"
      },
      "calendar": {
        "format": {
          "months": "<span color='#ffead3'><b>{}</b></span>",
          "today": "<span color='#ff6699'><b>{}</b></span>",
          "weekdays": "<span color='#ffcc66'><b>{}</b></span>"
        },
        "mode-mon-col": 3,
        "on-click-right": "mode",
        "on-scroll": 1
      },
      "format": "{:%M}",
      "interval": 1,
      "rotate": 0,
      "tooltip-format": "<tt>{calendar}</tt>"
    },
    "clock#S": {
      "actions": {
        "on-click-backward": "tz_down",
        "on-click-forward": "tz_up",
        "on-click-right": "mode",
        "on-scroll-down": "shift_down",
        "on-scroll-up": "shift_up"
      },
      "calendar": {
        "format": {
          "months": "<span color='#ffead3'><b>{}</b></span>",
          "today": "<span color='#ff6699'><b>{}</b></span>",
          "weekdays": "<span color='#ffcc66'><b>{}</b></span>"
        },
        "mode-mon-col": 3,
        "on-click-right": "mode",
        "on-scroll": 1
      },
      "format": "{:%S}",
      "interval": 1,
      "rotate": 0,
      "tooltip-format": "<tt>{calendar}</tt>"
    },
    "custom/audio_switch": {
      "exec": "~/.config/waybar/audio_switch.sh",
      "on-click": "~/.config/waybar/audio_switch.sh -s",
      "restart-interval": 1,
      "tooltip-format": "Beep boop audio"
    },
    "custom/menu": {
      "format": "󰅃",
      "rotate": 0
    },
    "custom/server_temp": {
      "exec": "~/.config/waybar/server_temp.sh",
      "rotate": 90,
      "tooltip-format": "Maid0"
    },
    "custom/spacer": {
      "format": "|",
      "rotate": 90,
      "tooltip": false
    },
    "group/expand": {
      "drawer": {
        "children-class": "not-power",
        "transition-duration": 600,
        "transition-to-left": true
      },
      "modules": [
        "custom/menu",
        "tray"
      ],
      "orientation": "vertical"
    },
    "hyprland/window": {
      "format": "{class}",
      "icon": false,
      "icon-size": 13,
      "max-length": 120,
      "rotate": 90
    },
    "hyprland/workspaces": {
      "format": "{icon}",
      "format-icons": {
        "active": "",
        "default": "",
        "empty": ""
      },
      "persistent-workspaces": {
        "DP-1": [
          "1",
          "2",
          "3",
          "4",
          "5"
        ]
      }
    },
    "margin-bottom": 10,
    "margin-left": 10,
    "margin-right": -5,
    "margin-top": 10,
    "mod": "dock",
    "modules-left": [
      "custom/spacer",
      "hyprland/workspaces"
    ],
    "modules-center": [
      "hyprland/window"
    ],
    "modules-right": [
      "custom/spacer",
      "custom/audio_switch",
      "group/expand",
      "clock#H",
      "clock#M",
      "clock#S",
      "custom/spacer",
      "custom/spacer"
    ],
    "output": "DP-1",
    "position": "left",
    "reload_style_on_change": true,
    "tray": {
      "icon-size": 16,
      "rotate": 0,
      "spacing": 3
    },
    "width": 50
  }
]
